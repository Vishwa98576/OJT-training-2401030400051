<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Fresh Blossom - Contact & Order</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #fff0f5;
      color: #5c1a32;
    }

    header {
      text-align: center;
      padding: 40px 20px 20px;
    }

    header h1 {
      font-size: 2.5em;
      color: #d6336c;
    }

    header p {
      font-size: 1.2em;
      color: #8b2c50;
    }

    .form-container {
      max-width: 600px;
      margin: 0 auto;
      background-color: #ffe6f0;
      padding: 30px;
      border-radius: 20px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    form {
      display: flex;
      flex-direction: column;
    }

    label {
      margin-top: 15px;
      font-weight: bold;
    }

    input, textarea, select {
      padding: 10px;
      margin-top: 5px;
      border-radius: 10px;
      border: 1px solid #ccc;
      font-size: 1em;
    }

    button {
      margin-top: 20px;
      padding: 12px;
      background-color: #d6336c;
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 1.1em;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    button:hover {
      background-color: #b72559;
    }
  </style>
</head>
<body>

  <header>
    <h1>Contact & Order</h1>
    <p>Place your order or get in touch with us</p>
  </header>

  <div class="form-container">
    <form action="#" method="post">
      <label for="name">Full Name</label>
      <input type="text" id="name" name="name" required>

      <label for="Address">Address</label>
      <input type="text" id="Address" name="Address" required>

      <label for="phone numer">Phone Number</label>
      <input type="number" id="phone number" name="phone number" required>

      <label for="message">Message / Special Request</label>
      <textarea id="message" name="message" rows="5"></textarea>

      <button type="submit">Submit Order</button>
    </form>
  </div>

</body>
</html>
