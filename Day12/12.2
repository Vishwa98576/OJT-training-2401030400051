<!-- ======== NAVBAR ======== -->
<nav id="navbar"
  class="fixed top-0 left-0 right-0 z-50 h-[70px] flex items-center justify-between px-8
  bg-[rgba(13,15,26,0.85)] backdrop-blur-xl border-b border-white/10">

