<script src="script.js"></script> 

/* =============================================
   SLUMBER — Sleep Diary Website
   script.js — All JavaScript / jQuery Logic
   ============================================= */

$(document).ready(function () {

  // ============================================
  // 1. STARS CANVAS ANIMATION
  // ============================================
  const canvas = document.getElementById('starsCanvas');
  const ctx = canvas.getContext('2d');
  let stars = [];

  function resizeCanvas() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
    generateStars();
  }

  function generateStars() {
    stars = [];
    const count = Math.floor((canvas.width * canvas.height) / 4500);
    for (let i = 0; i < count; i++) {
      stars.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: Math.random() * 1.8 + 0.3,
        alpha: Math.random(),
        speed: Math.random() * 0.01 + 0.003,
        dir: Math.random() > 0.5 ? 1 : -1,
      });
    }
  }

  function animateStars() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    stars.forEach(s => {
      s.alpha += s.speed * s.dir;
      if (s.alpha > 1 || s.alpha < 0.1) s.dir *= -1;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255,255,255,${s.alpha})`;
      ctx.fill();
    });
    requestAnimationFrame(animateStars);
  }

  resizeCanvas();
  animateStars();
  window.addEventListener('resize', resizeCanvas);

  // ============================================
  // 2. DARK / LIGHT MODE TOGGLE
  // ============================================
  const savedTheme = localStorage.getItem('slumber_theme') || 'dark';
  $('html').attr('data-theme', savedTheme);
  updateThemeIcon(savedTheme);

  $('#themeToggle').on('click', function () {
    const current = $('html').attr('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    $('html').attr('data-theme', next);
    localStorage.setItem('slumber_theme', next);
    updateThemeIcon(next);
  });

  function updateThemeIcon(theme) {
    $('#themeToggle .theme-icon').text(theme === 'dark' ? '☀️' : '🌙');
  }

  // ============================================
  // 3. NAVBAR — Hamburger + Active Link + Sticky
  // ============================================
 // Hamburger Menu
$('#hamburger').on('click', function () {
  $('#navLinks').toggleClass('right-0');
  $('#navLinks').toggleClass('right-[-100%]');
});

// Close menu on nav click
$('.nav-link').on('click', function () {
  $('#navLinks').removeClass('right-0');
  $('#navLinks').addClass('right-[-100%]');
});

// Active nav on scroll
$(window).on('scroll', function () {

  const scrollY = $(this).scrollTop();

  $('section[id]').each(function () {

    const top = $(this).offset().top - 100;
    const bottom = top + $(this).outerHeight();

    if (scrollY >= top && scrollY < bottom) {

      const id = $(this).attr('id');

      $('.nav-link').removeClass('active');

      $(`.nav-link[href="#${id}"]`).addClass('active');
    }
  });

  // Scroll Top Button
  if (scrollY > 300) {
    $('#scrollTop').removeClass('hidden');
  } else {
    $('#scrollTop').addClass('hidden');
  }
});

// Scroll to top
$('#scrollTop').on('click', function () {
  $('html, body').animate({ scrollTop: 0 }, 500);
});

  // ============================================
  // 4. SLEEP QUOTES — Random Display with jQuery
  // ============================================
  const quotes = [
    { text: "Sleep is the golden chain that ties health and our bodies together.", author: "Thomas Dekker" },
    { text: "A good laugh and a long sleep are the best cures in the doctor's book.", author: "Irish Proverb" },
    { text: "Sleep is the best meditation.", author: "Dalai Lama" },
    { text: "Man should forget his anger before he lies down to sleep.", author: "Mahatma Gandhi" },
    { text: "Each night, when I go to sleep, I die. And the next morning, when I wake up, I am reborn.", author: "Mahatma Gandhi" },
    { text: "The best bridge between despair and hope is a good night's sleep.", author: "E. Joseph Cossman" },
    { text: "Sleep is that golden chain that ties health and our bodies together.", author: "Thomas Dekker" },
    { text: "Without enough sleep, we all become tall two-year-olds.", author: "JoJo Jensen" },
    { text: "Think in the morning. Act in the noon. Eat in the evening. Sleep in the night.", author: "William Blake" },
    { text: "Sleep is not a waste of time. It is nature's way of fueling greatness.", author: "Unknown" },
    { text: "Early to bed and early to rise makes a man healthy, wealthy, and wise.", author: "Benjamin Franklin" },
    { text: "Fatigue is the best pillow.", author: "Benjamin Franklin" },
  ];

  let lastQuoteIndex = -1;

  function showRandomQuote() {
    let idx;
    do { idx = Math.floor(Math.random() * quotes.length); } while (idx === lastQuoteIndex);
    lastQuoteIndex = idx;
    const q = quotes[idx];
    // Fade out, change, fade in
    $('#quoteText, #quoteAuthor').animate({ opacity: 0 }, 250, function () {
      $('#quoteText').text(q.text);
      $('#quoteAuthor').text('— ' + q.author);
      $('#quoteText, #quoteAuthor').animate({ opacity: 1 }, 350);
    });
  }

  $('#newQuoteBtn').on('click', showRandomQuote);

  // ============================================
  // 5. SLEEP TRACKER — Calculate Hours & Status
  // ============================================
  $('#calcSleepBtn').on('click', function () {
    const sleepVal = $('#sleepTime').val();
    const wakeVal = $('#wakeTime').val();

    if (!sleepVal || !wakeVal) {
      alert('Please enter both sleep and wake-up times.');
      return;
    }

    // Parse times into minutes
    const sleepMins = timeToMins(sleepVal);
    const wakeMins = timeToMins(wakeVal);

    // Handle overnight sleep (e.g., 22:30 -> 06:30)
    let diff = wakeMins - sleepMins;
    if (diff < 0) diff += 1440; // 24 * 60

    const hours = parseFloat((diff / 60).toFixed(1));

    // Display result
    $('#sleepHours').text(hours);

    // Determine sleep status and AI tips
    let statusHTML, tip, statusClass;

    if (hours < 6) {
      statusClass = 'status-poor';
      statusHTML = '⚠️ Poor Sleep';
      tip = getSleepTip('poor', hours);
    } else if (hours <= 9) {
      statusClass = 'status-healthy';
      statusHTML = '✅ Healthy Sleep';
      tip = getSleepTip('healthy', hours);
    } else {
      statusClass = 'status-over';
      statusHTML = '💤 Oversleep';
      tip = getSleepTip('over', hours);
    }

    $('#sleepStatus').html(`<span class="${statusClass}">${statusHTML}</span>`);
    $('#sleepTip').text(tip);

    // Save this log
    saveWeekdayLog(hours);

    // Show result panel
    $('#sleepResult').hide().css('display', 'flex').hide().fadeIn(400);
    refreshAnalytics();
  });

  function timeToMins(t) {
    const [h, m] = t.split(':').map(Number);
    return h * 60 + m;
  }

  // ======= AI Sleep Tips =======
  function getSleepTip(status, hours) {
    const tips = {
      poor: [
        `You slept only ${hours} hours. Aim for at least 7–9 hours. Try going to bed 30 minutes earlier tonight.`,
        `${hours} hours is below recommended. Avoid screens 1 hour before bed and consider a consistent sleep schedule.`,
        `Short sleep can affect mood and focus. Try a calming routine: warm tea, dim lights, and a consistent bedtime.`
      ],
      healthy: [
        `Great job! ${hours} hours is within the healthy range. Keep your sleep schedule consistent for best results.`,
        `${hours} hours is ideal. You're likely well-rested. Maintain this by keeping a regular bedtime and wake time.`,
        `Excellent! Consistent healthy sleep improves memory, mood, and immunity. Keep it up! 🌟`
      ],
      over: [
        `${hours} hours might be too much. Oversleeping can cause grogginess. Try waking at the same time each day.`,
        `Sleeping over 9 hours regularly may signal an underlying issue. Consider checking with a healthcare professional.`,
        `Too much sleep can disrupt your circadian rhythm. Set an alarm and get some morning sunlight to reset your clock.`
      ]
    };
    const arr = tips[status];
    return arr[Math.floor(Math.random() * arr.length)];
  }

  // ============================================
  // 6. DAILY SLEEP DIARY — Save & Display
  // ============================================
  let selectedMood = '';

  // Mood Picker
  $(document).on('click', '.mood-btn', function () {
    $('.mood-btn').removeClass('selected');
    $(this).addClass('selected');
    selectedMood = $(this).data('mood');
  });

  // Set today's date by default
  const today = new Date().toISOString().split('T')[0];
  $('#diaryDate').val(today);

  // Save Diary Entry
  $('#saveDiaryBtn').on('click', function () {
    const date = $('#diaryDate').val() || today;
    const entry = $('#diaryEntry').val().trim();
    const mood = selectedMood || '😐';

    if (!entry) {
      alert('Please write something in your diary!');
      return;
    }

    // Get existing entries
    const entries = getDiaryEntries();

    // Add new entry
    entries.unshift({ date, mood, entry, id: Date.now() });

    // Save to localStorage
    localStorage.setItem('slumber_diary', JSON.stringify(entries));

    // Clear form
    $('#diaryEntry').val('');
    selectedMood = '';
    $('.mood-btn').removeClass('selected');

    // Refresh display
    renderDiaryEntries();
    updateHeroStats();

    // Visual feedback
    $('#saveDiaryBtn').text('Saved! ✅').prop('disabled', true);
    setTimeout(() => {
      $('#saveDiaryBtn').text('Save Entry 💾').prop('disabled', false);
    }, 2000);
  });

  function getDiaryEntries() {
    try {
      return JSON.parse(localStorage.getItem('slumber_diary')) || [];
    } catch { return []; }
  }

  function renderDiaryEntries() {
    const entries = getDiaryEntries();
    const $list = $('#diaryEntriesList');
    $list.empty();

    if (!entries.length) {
      $list.html('<p class="empty-state">No entries yet. Start writing! ✍️</p>');
      return;
    }

    entries.forEach(e => {
      const html = `
        <div class="entry-item" data-id="${e.id}">
          <div class="entry-header">
            <span class="entry-date">📅 ${formatDate(e.date)}</span>
            <span>
              <span class="entry-mood">${e.mood}</span>
              <button class="delete-entry" data-id="${e.id}">✕</button>
            </span>
          </div>
          <div class="entry-text">${escapeHTML(e.entry)}</div>
        </div>
      `;
      $list.append(html);
    });
  }

  // Delete diary entry
  $(document).on('click', '.delete-entry', function () {
    const id = parseInt($(this).data('id'));
    let entries = getDiaryEntries().filter(e => e.id !== id);
    localStorage.setItem('slumber_diary', JSON.stringify(entries));
    renderDiaryEntries();
    updateHeroStats();
  });

  function formatDate(d) {
    const opts = { year: 'numeric', month: 'short', day: 'numeric' };
    return new Date(d + 'T00:00:00').toLocaleDateString(undefined, opts);
  }

  function escapeHTML(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // ============================================
  // 7. WEEKLY SLEEP DATA — Input + Storage
  // ============================================
  const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];

  // Generate weekly input fields
  function buildWeeklyInputs() {
    const $container = $('#weeklyInputs');
    $container.empty();
    const saved = getWeeklyData();
    days.forEach((day, i) => {
      $container.append(`
        <div class="weekly-input-wrap">
          <label>${day}</label>
          <input type="number" class="weekly-day-input" data-day="${i}"
            min="0" max="24" step="0.5"
            value="${saved[i] !== undefined ? saved[i] : ''}"
            placeholder="hrs"/>
        </div>
      `);
    });
  }

  buildWeeklyInputs();

  $('#saveWeeklyBtn').on('click', function () {
    const data = [];
    $('.weekly-day-input').each(function () {
      const val = parseFloat($(this).val());
      data.push(isNaN(val) ? 0 : val);
    });
    localStorage.setItem('slumber_weekly', JSON.stringify(data));
    refreshAnalytics();

    $(this).text('Saved! ✅').prop('disabled', true);
    setTimeout(() => { $(this).text('Save Weekly Data 📊').prop('disabled', false); }, 2000);
  });

  function getWeeklyData() {
    try {
      return JSON.parse(localStorage.getItem('slumber_weekly')) || [];
    } catch { return []; }
  }

  // Save today's calculated sleep to the weekly log
  function saveWeekdayLog(hours) {
    const data = getWeeklyData();
    if (data.length === 0) {
      for (let i = 0; i < 7; i++) data.push(0);
    }
    // Use current day of week (0=Sun, adjust to Mon=0)
    let day = new Date().getDay();
    day = day === 0 ? 6 : day - 1;
    data[day] = hours;
    localStorage.setItem('slumber_weekly', JSON.stringify(data));
    buildWeeklyInputs(); // refresh inputs
  }

  // ============================================
  // 8. ANALYTICS — Cards, Progress Bars, Graph
  // ============================================
  function refreshAnalytics() {
    const data = getWeeklyData();
    const nonZero = data.filter(h => h > 0);

    if (!nonZero.length) {
      $('#avgSleepCard, #avgSleepHero, #bestSleep, #worstSleep, #healthyNights').text('—');
      renderProgressBars([]);
      renderBarGraph([]);
      return;
    }

    const avg = (nonZero.reduce((a, b) => a + b, 0) / nonZero.length).toFixed(1);
    const best = Math.max(...nonZero).toFixed(1);
    const worst = Math.min(...nonZero).toFixed(1);
    const healthy = nonZero.filter(h => h >= 6 && h <= 9).length;

    $('#avgSleepCard').text(avg + 'h');
    $('#avgSleepHero').text(avg + 'h');
    $('#bestSleep').text(best + 'h');
    $('#worstSleep').text(worst + 'h');
    $('#healthyNights').text(healthy + '/' + nonZero.length);

    renderProgressBars(data);
    renderBarGraph(data);
    updateHeroStats();
  }

  function renderProgressBars(data) {
    const $container = $('#progressBars');
    $container.empty();
    const maxHours = 12;

    days.forEach((day, i) => {
      const hours = data[i] || 0;
      const pct = Math.min((hours / maxHours) * 100, 100);
      let color = '#ff6b6b';
      if (hours >= 6 && hours <= 9) color = 'var(--teal)';
      else if (hours > 9) color = 'var(--gold)';

      $container.append(`
        <div class="progress-row">
          <span class="progress-day">${day}</span>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" style="background:${color};" data-pct="${pct}"></div>
          </div>
          <span class="progress-val">${hours ? hours + 'h' : '—'}</span>
        </div>
      `);
    });

    // Animate bars (after a brief delay so DOM is ready)
    setTimeout(() => {
      $('.progress-bar-fill').each(function () {
        $(this).css('width', $(this).data('pct') + '%');
      });
    }, 100);
  }

  function renderBarGraph(data) {
    const $graph = $('#barGraph');
    const $labels = $('#graphLabels');
    $graph.empty();
    $labels.empty();

    const maxHours = Math.max(12, ...(data.filter(h => h > 0)));

    days.forEach((day, i) => {
      const hours = data[i] || 0;
      const pctHeight = (hours / maxHours) * 100;
      let color = 'rgba(255,107,107,0.7)';
      if (hours >= 6 && hours <= 9) color = 'rgba(78,205,196,0.75)';
      else if (hours > 9) color = 'rgba(244,197,66,0.75)';

      // Bar
      $graph.append(`
        <div class="bar-wrap">
          <span class="bar-value">${hours ? hours + 'h' : ''}</span>
          <div class="bar" data-h="${pctHeight}"
            style="height:0%; background:${color}; border: 1px solid rgba(255,255,255,0.1);"
            title="${day}: ${hours}h">
          </div>
        </div>
      `);

      // Label
      $labels.append(`<span class="graph-label">${day}</span>`);
    });

    // Animate bars
    setTimeout(() => {
      $('.bar').each(function () {
        $(this).animate({ height: $(this).data('h') + '%' }, 1000);
      });
    }, 150);
  }

  // ============================================
  // 9. HERO STATS — Update Counters
  // ============================================
  function updateHeroStats() {
    const entries = getDiaryEntries();
    $('#totalEntries').text(entries.length);

    const data = getWeeklyData();
    const nonZero = data.filter(h => h > 0);
    if (nonZero.length) {
      const avg = (nonZero.reduce((a, b) => a + b, 0) / nonZero.length).toFixed(1);
      $('#avgSleepHero').text(avg + 'h');
    }
  }

  // ============================================
  // 10. LOGIN & SIGNUP — Form Validation
  // ============================================
  // Tab switching
  $('#loginTab').on('click', function () {
    switchAuthTab('login');
  });

  $('#signupTab').on('click', function () {
    switchAuthTab('signup');
  });

  $('#goSignup').on('click', function (e) {
    e.preventDefault();
    switchAuthTab('signup');
  });

  $('#goLogin').on('click', function (e) {
    e.preventDefault();
    switchAuthTab('login');
  });

  function switchAuthTab(tab) {
    // Update tabs
    $('.auth-tab').removeClass('active');
    if (tab === 'login') {
      $('#loginTab').addClass('active');
      $('#loginForm').removeClass('hidden');
      $('#signupForm').addClass('hidden');
    } else {
      $('#signupTab').addClass('active');
      $('#signupForm').removeClass('hidden');
      $('#loginForm').addClass('hidden');
    }
    $('#loggedInPanel').addClass('hidden');
  }

  // Check if user is already logged in
  function checkLoginState() {
    const user = getLoggedInUser();
    if (user) {
      showLoggedInPanel(user.name);
    }
  }

  function getLoggedInUser() {
    try {
      return JSON.parse(localStorage.getItem('slumber_current_user'));
    } catch { return null; }
  }

  function showLoggedInPanel(name) {
    $('#loginForm').addClass('hidden');
    $('#signupForm').addClass('hidden');
    $('#loggedInPanel').removeClass('hidden');
    $('#loggedInName').text(name);
  }

  // SIGNUP
  $('#signupBtn').on('click', function () {
    const name = $('#signupName').val().trim();
    const email = $('#signupEmail').val().trim();
    const pass = $('#signupPassword').val();

    let valid = true;

    // Clear errors
    $('#signupNameErr, #signupEmailErr, #signupPassErr').text('');

    if (!name) {
      $('#signupNameErr').text('Name is required.');
      valid = false;
    }
    if (!validateEmail(email)) {
      $('#signupEmailErr').text('Enter a valid email address.');
      valid = false;
    }
    if (pass.length < 6) {
      $('#signupPassErr').text('Password must be at least 6 characters.');
      valid = false;
    }

    if (!valid) return;

    // Check if email already registered
    const users = getUsers();
    if (users.find(u => u.email === email)) {
      $('#signupMsg').text('This email is already registered.').removeClass('msg-success').addClass('msg-error');
      return;
    }

    // Save user
    users.push({ name, email, password: pass });
    localStorage.setItem('slumber_users', JSON.stringify(users));
    localStorage.setItem('slumber_current_user', JSON.stringify({ name, email }));

    $('#signupMsg').text('Account created! Welcome 🌙').removeClass('msg-error').addClass('msg-success');

    setTimeout(() => {
      showLoggedInPanel(name);
    }, 1200);
  });

  // LOGIN
  $('#loginBtn').on('click', function () {
    const email = $('#loginEmail').val().trim();
    const pass = $('#loginPassword').val();

    let valid = true;
    $('#loginEmailErr, #loginPassErr').text('');

    if (!validateEmail(email)) {
      $('#loginEmailErr').text('Enter a valid email address.');
      valid = false;
    }
    if (!pass) {
      $('#loginPassErr').text('Please enter your password.');
      valid = false;
    }

    if (!valid) return;

    // Check credentials
    const users = getUsers();
    const user = users.find(u => u.email === email && u.password === pass);

    if (!user) {
      $('#loginMsg').text('Invalid email or password.').removeClass('msg-success').addClass('msg-error');
      return;
    }

    localStorage.setItem('slumber_current_user', JSON.stringify({ name: user.name, email: user.email }));
    $('#loginMsg').text('Welcome back! 🌙').removeClass('msg-error').addClass('msg-success');

    setTimeout(() => {
      showLoggedInPanel(user.name);
    }, 1000);
  });

  // LOGOUT
  $('#logoutBtn').on('click', function () {
    localStorage.removeItem('slumber_current_user');
    $('#loggedInPanel').addClass('hidden');
    switchAuthTab('login');
    $('#loginMsg').text('Logged out successfully.').removeClass('msg-error').addClass('msg-success');
  });

  function getUsers() {
    try {
      return JSON.parse(localStorage.getItem('slumber_users')) || [];
    } catch { return []; }
  }

  function validateEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  // Show/Hide password toggle
  $(document).on('click', '.eye-btn', function () {
    const targetId = $(this).data('target');
    const $input = $('#' + targetId);
    const type = $input.attr('type') === 'password' ? 'text' : 'password';
    $input.attr('type', type);
    $(this).text(type === 'password' ? '👁' : '🙈');
  });

  // ============================================
  // 11. SLEEP REMINDER — Set Bedtime Alert
  // ============================================
  let reminderInterval = null;

  $('#setReminderBtn').on('click', function () {
    const reminderTime = $('#reminderTime').val();
    if (!reminderTime) {
      alert('Please set a reminder time!');
      return;
    }

    // Clear any existing reminder
    if (reminderInterval) clearInterval(reminderInterval);

    $('#reminderStatus').text(`⏰ Reminder set for ${formatTime12(reminderTime)}`);

    // Check every 30 seconds if it's time
    reminderInterval = setInterval(function () {
      const now = new Date();
      const currentTime = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');

      if (currentTime === reminderTime) {
        clearInterval(reminderInterval);
        reminderInterval = null;

        // Show browser notification or alert
        if ('Notification' in window && Notification.permission === 'granted') {
          new Notification('🌙 Slumber Reminder', {
            body: "It's time for bed! Get some rest and sleep well. 😴",
            icon: '🌙'
          });
        } else {
          alert(`🌙 Slumber Reminder!\n\nIt's ${formatTime12(reminderTime)} — time for bed!\nSleep well! 😴`);
        }

        $('#reminderStatus').text('✅ Reminder triggered!');
      }
    }, 30000);

    // Request notification permission if not yet granted
    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }
  });

  function formatTime12(t) {
    const [h, m] = t.split(':').map(Number);
    const ampm = h >= 12 ? 'PM' : 'AM';
    const hour12 = h % 12 || 12;
    return `${hour12}:${m.toString().padStart(2, '0')} ${ampm}`;
  }

  // ============================================
  // 12. SMOOTH SCROLLING for Navbar Links
  // ============================================
  $('.nav-link').on('click', function (e) {
    const href = $(this).attr('href');
    if (href && href.startsWith('#')) {
      e.preventDefault();
      const target = $(href);
      if (target.length) {
        $('html, body').animate({
          scrollTop: target.offset().top - 70
        }, 600, 'swing');
      }
    }
  });

  // ============================================
  // 13. INITIALIZATION — Load Saved Data
  // ============================================
  function init() {
    renderDiaryEntries();
    refreshAnalytics();
    updateHeroStats();
    checkLoginState();
    showRandomQuote();
  }

  init();

}); // End document.ready


/* =============================================
   SLUMBER — Sleep Diary Website
   style.css — Complete Stylesheet
   ============================================= */

/* ---------- CSS Variables (Themes) ---------- */
:root {
  --bg-primary: #0d0f1a;
  --bg-secondary: #131627;
  --bg-card: #1a1d30;
  --bg-card-hover: #1f2340;
  --accent: #7c6af7;
  --accent-soft: #a594f9;
  --accent-glow: rgba(124, 106, 247, 0.3);
  --gold: #f4c542;
  --teal: #4ecdc4;
  --text-primary: #edeaf5;
  --text-secondary: #9d9bb8;
  --text-muted: #5a5870;
  --border: rgba(255,255,255,0.07);
  --border-accent: rgba(124, 106, 247, 0.4);
  --shadow: 0 8px 40px rgba(0,0,0,0.5);
  --shadow-accent: 0 4px 30px rgba(124, 106, 247, 0.25);
  --radius: 16px;
  --radius-sm: 10px;
  --nav-height: 68px;
}

[data-theme="light"] {
  --bg-primary: #f0edf8;
  --bg-secondary: #e8e4f4;
  --bg-card: #ffffff;
  --bg-card-hover: #f8f6ff;
  --accent: #6b5ce7;
  --accent-soft: #8b77f0;
  --accent-glow: rgba(107, 92, 231, 0.15);
  --gold: #e6a800;
  --teal: #2bb5ac;
  --text-primary: #1a1530;
  --text-secondary: #5a5280;
  --text-muted: #9089b0;
  --border: rgba(0,0,0,0.08);
  --border-accent: rgba(107, 92, 231, 0.3);
  --shadow: 0 8px 40px rgba(107, 92, 231, 0.12);
  --shadow-accent: 0 4px 30px rgba(107, 92, 231, 0.2);
}

/* ---------- Reset & Base ---------- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: 'DM Sans', sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.65;
  transition: background 0.4s, color 0.4s;
  overflow-x: hidden;
}

a { color: var(--accent-soft); text-decoration: none; }
a:hover { color: var(--accent); }
input, textarea, button { font-family: inherit; }

/* ---------- Scrollbar ---------- */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--bg-primary); }
::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 99px; }

/* ---------- Container ---------- */
.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 24px;
}

/* =============================================
   NAVBAR
   ============================================= */
.nav-link{
  @apply px-4 py-2 rounded-full text-gray-300 hover:bg-indigo-500/20 hover:text-white transition;
}

.nav-login-btn{
  @apply bg-indigo-500 text-white px-5 py-2 rounded-full hover:bg-indigo-400 transition;
}

.theme-toggle{
  @apply w-10 h-10 rounded-full border border-white/10 bg-[#1c1f2b]
  flex items-center justify-center text-lg hover:rotate-12
  hover:border-indigo-400 transition text-white;
}

.active{
  @apply bg-indigo-500/20 text-white;
}


/* =============================================
   BUTTONS
   ============================================= */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  border-radius: 99px;
  font-size: 0.95rem;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: all 0.25s;
  letter-spacing: 0.01em;
}

.btn-primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 4px 20px var(--accent-glow);
}

.btn-primary:hover {
  background: var(--accent-soft);
  transform: translateY(-2px);
  box-shadow: 0 8px 30px var(--accent-glow);
}

.btn-ghost {
  background: transparent;
  color: var(--text-primary);
  border: 1.5px solid var(--border-accent);
}

.btn-ghost:hover {
  background: var(--accent-glow);
  border-color: var(--accent);
  transform: translateY(-2px);
}

.btn-sm { padding: 8px 18px; font-size: 0.85rem; }
.btn-full { width: 100%; justify-content: center; margin-top: 8px; }

/* =============================================
   HERO SECTION
   ============================================= */
.hero {
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  padding-top: var(--nav-height);
}

#starsCanvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 680px;
  padding: 60px 24px 60px 8%;
}

.hero-eyebrow {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--accent-soft);
  margin-bottom: 18px;
}

.hero-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(2.8rem, 6vw, 4.8rem);
  line-height: 1.1;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 20px;
}

.hero-title em {
  font-style: italic;
  color: var(--accent-soft);
}

.hero-subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
  max-width: 500px;
  margin-bottom: 36px;
}

.hero-cta {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 50px;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 24px;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--accent-soft);
  line-height: 1;
}

.stat-label {
  font-size: 0.78rem;
  color: var(--text-muted);
  margin-top: 4px;
}

.stat-divider {
  width: 1px;
  height: 36px;
  background: var(--border);
}

/* Floating Moon */
.hero-moon {
  position: absolute;
  right: 8%;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}

.moon {
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, #fffde7, #f4c542 40%, #e8a210 70%, #b87000);
  box-shadow: 0 0 60px rgba(244, 197, 66, 0.4), inset -30px -20px 60px rgba(0,0,0,0.35);
  animation: moonFloat 6s ease-in-out infinite;
}

.moon-glow {
  position: absolute;
  inset: -30px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(244,197,66,0.15) 0%, transparent 70%);
  animation: moonFloat 6s ease-in-out infinite;
}

@keyframes moonFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20px); }
}

.scroll-hint {
  position: absolute;
  bottom: 32px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 0.78rem;
  color: var(--text-muted);
  letter-spacing: 0.1em;
  animation: bounce 2s ease-in-out infinite;
  z-index: 2;
}

@keyframes bounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50% { transform: translateX(-50%) translateY(8px); }
}

/* =============================================
   QUOTE SECTION
   ============================================= */
.quote-section {
  padding: 60px 0;
  background: linear-gradient(135deg, var(--bg-secondary), var(--bg-primary));
}

.quote-card {
  background: var(--bg-card);
  border: 1px solid var(--border-accent);
  border-radius: var(--radius);
  padding: 40px 48px;
  text-align: center;
  position: relative;
  box-shadow: var(--shadow-accent);
}

.quote-mark {
  font-family: 'Playfair Display', serif;
  font-size: 6rem;
  color: var(--accent);
  opacity: 0.25;
  line-height: 0.5;
  margin-bottom: 16px;
}

.quote-text {
  font-family: 'Playfair Display', serif;
  font-size: 1.35rem;
  font-style: italic;
  color: var(--text-primary);
  max-width: 640px;
  margin: 0 auto 12px;
  transition: opacity 0.4s;
}

.quote-author {
  font-size: 0.9rem;
  color: var(--accent-soft);
  margin-bottom: 24px;
}

/* =============================================
   SECTIONS — Common
   ============================================= */
.section {
  padding: 90px 0;
}

.section-alt {
  background: var(--bg-secondary);
}

.section-header {
  text-align: center;
  margin-bottom: 50px;
}

.section-tag {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent-soft);
  background: var(--accent-glow);
  border: 1px solid var(--border-accent);
  border-radius: 99px;
  padding: 4px 14px;
  margin-bottom: 14px;
}

.section-title {
  font-family: 'Playfair Display', serif;
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12px;
}

.section-sub {
  font-size: 1rem;
  color: var(--text-secondary);
  max-width: 500px;
  margin: 0 auto;
}

/* =============================================
   SLEEP TRACKER
   ============================================= */
.tracker-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 40px;
  max-width: 600px;
  margin: 0 auto;
  box-shadow: var(--shadow);
}

.time-inputs {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.input-group {
  flex: 1;
  min-width: 160px;
}

.input-group label {
  display: block;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.input-group input[type="time"],
input[type="date"] {
  width: 100%;
  padding: 12px 16px;
  background: var(--bg-primary);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 1.05rem;
  transition: border-color 0.25s;
}

.input-group input:focus, input[type="date"]:focus {
  outline: none;
  border-color: var(--accent);
}

.input-arrow {
  font-size: 1.5rem;
  color: var(--text-muted);
  padding-top: 20px;
}

/* Sleep Result */
.sleep-result {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 28px;
  padding: 24px;
  background: var(--bg-primary);
  border-radius: var(--radius-sm);
  border: 1px solid var(--border-accent);
  animation: fadeIn 0.5s ease;
  flex-wrap: wrap;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.result-circle {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: conic-gradient(var(--accent) 0%, var(--bg-card) 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4px solid var(--accent);
  box-shadow: 0 0 30px var(--accent-glow);
  flex-shrink: 0;
  position: relative;
}

.result-hours {
  font-family: 'Playfair Display', serif;
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.result-label {
  font-size: 0.72rem;
  color: var(--text-secondary);
}

.sleep-status {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 8px;
}

.sleep-tip {
  font-size: 0.88rem;
  color: var(--text-secondary);
  line-height: 1.55;
}

.status-poor { color: #ff6b6b; }
.status-healthy { color: #4ecdc4; }
.status-over { color: var(--gold); }

/* Reminder Row */
.reminder-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
}

.reminder-row label {
  font-size: 0.85rem;
  color: var(--text-secondary);
  white-space: nowrap;
}

.reminder-row input[type="time"] {
  padding: 8px 12px;
  background: var(--bg-primary);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.9rem;
}

.reminder-status {
  font-size: 0.82rem;
  color: var(--teal);
}

/* =============================================
   SLEEP DIARY
   ============================================= */
.diary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
}

.diary-form-card,
.diary-entries-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  box-shadow: var(--shadow);
}

.diary-date-row {
  margin-bottom: 20px;
}

.mood-label {
  font-size: 0.88rem;
  color: var(--text-secondary);
  margin-bottom: 12px;
}

.moods {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.mood-btn {
  font-size: 1.6rem;
  background: var(--bg-primary);
  border: 2px solid var(--border);
  border-radius: 50%;
  width: 48px; height: 48px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex; align-items: center; justify-content: center;
}

.mood-btn:hover, .mood-btn.selected {
  border-color: var(--accent);
  transform: scale(1.15);
  background: var(--accent-glow);
}

textarea {
  width: 100%;
  padding: 14px 16px;
  background: var(--bg-primary);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.95rem;
  resize: vertical;
  transition: border-color 0.25s;
  line-height: 1.6;
}

textarea:focus {
  outline: none;
  border-color: var(--accent);
}

.entries-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  margin-bottom: 20px;
  color: var(--text-primary);
}

.entries-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  max-height: 400px;
  overflow-y: auto;
  padding-right: 6px;
}

.entry-item {
  background: var(--bg-primary);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  animation: fadeIn 0.3s ease;
}

.entry-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.entry-date {
  font-size: 0.8rem;
  color: var(--accent-soft);
  font-weight: 500;
}

.entry-mood { font-size: 1.1rem; }

.entry-text {
  font-size: 0.88rem;
  color: var(--text-secondary);
  white-space: pre-line;
  line-height: 1.55;
}

.delete-entry {
  background: none;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 0.85rem;
  transition: color 0.2s;
  margin-left: 6px;
}

.delete-entry:hover { color: #ff6b6b; }

.empty-state {
  color: var(--text-muted);
  font-size: 0.9rem;
  text-align: center;
  padding: 30px 0;
}

/* =============================================
   ANALYTICS
   ============================================= */
.analytics-cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 50px;
}

.analytics-card {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 28px 24px;
  text-align: center;
  transition: all 0.25s;
  box-shadow: var(--shadow);
}

.analytics-card:hover {
  border-color: var(--accent);
  transform: translateY(-4px);
  box-shadow: var(--shadow-accent);
}

.a-card-icon { font-size: 1.8rem; margin-bottom: 10px; }

.a-card-value {
  font-family: 'Playfair Display', serif;
  font-size: 2rem;
  font-weight: 700;
  color: var(--accent-soft);
  line-height: 1;
  margin-bottom: 6px;
}

.a-card-label {
  font-size: 0.8rem;
  color: var(--text-secondary);
}

/* Progress Bars */
.progress-section, .graph-section { margin-bottom: 50px; }

.progress-title, .graph-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  color: var(--text-primary);
  margin-bottom: 20px;
}

.progress-bars { display: flex; flex-direction: column; gap: 14px; }

.progress-row {
  display: flex;
  align-items: center;
  gap: 14px;
}

.progress-day {
  width: 36px;
  font-size: 0.8rem;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.progress-bar-bg {
  flex: 1;
  height: 10px;
  background: var(--bg-card);
  border-radius: 99px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 99px;
  width: 0%;
  transition: width 1.2s cubic-bezier(0.25, 1, 0.5, 1);
}

.progress-val {
  font-size: 0.8rem;
  color: var(--text-secondary);
  width: 36px;
  text-align: right;
}

/* Bar Graph */
.bar-graph {
  display: flex;
  align-items: flex-end;
  gap: 10px;
  height: 180px;
  padding: 10px 0;
  border-bottom: 2px solid var(--border);
  margin-bottom: 8px;
}

.bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  height: 100%;
  justify-content: flex-end;
}

.bar {
  width: 100%;
  max-width: 54px;
  border-radius: 8px 8px 0 0;
  transition: height 1.2s cubic-bezier(0.25, 1, 0.5, 1);
  position: relative;
  cursor: pointer;
}

.bar:hover { filter: brightness(1.2); }

.bar-value {
  font-size: 0.72rem;
  color: var(--text-secondary);
}

.graph-labels {
  display: flex;
  gap: 10px;
}

.graph-label {
  flex: 1;
  text-align: center;
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* Weekly Form */
.weekly-form {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  box-shadow: var(--shadow);
}

.weekly-form h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.2rem;
  margin-bottom: 8px;
  color: var(--text-primary);
}

.weekly-inputs {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12px;
  margin: 20px 0;
}

.weekly-input-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.weekly-input-wrap label {
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.weekly-input-wrap input {
  width: 100%;
  padding: 8px;
  background: var(--bg-primary);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.9rem;
  text-align: center;
  transition: border-color 0.25s;
}

.weekly-input-wrap input:focus {
  outline: none;
  border-color: var(--accent);
}

/* =============================================
   LOGIN / SIGNUP
   ============================================= */
.auth-wrapper {
  max-width: 440px;
  margin: 0 auto;
}

.auth-tabs {
  display: flex;
  gap: 0;
  background: var(--bg-card);
  border-radius: 99px;
  padding: 4px;
  margin-bottom: 30px;
  border: 1px solid var(--border);
}

.auth-tab {
  flex: 1;
  padding: 10px;
  border: none;
  background: none;
  border-radius: 99px;
  color: var(--text-secondary);
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.25s;
}

.auth-tab.active {
  background: var(--accent);
  color: #fff;
}

.auth-form {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 36px;
  box-shadow: var(--shadow);
}

.auth-form.hidden { display: none; }

.auth-title {
  font-family: 'Playfair Display', serif;
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24px;
}

.form-group {
  margin-bottom: 18px;
}

.form-group label {
  display: block;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.form-group input {
  width: 100%;
  padding: 12px 16px;
  background: var(--bg-primary);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
  font-size: 0.95rem;
  transition: border-color 0.25s;
}

.form-group input:focus {
  outline: none;
  border-color: var(--accent);
}

.password-wrap {
  position: relative;
}

.password-wrap input { padding-right: 48px; }

.eye-btn {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  color: var(--text-muted);
  transition: color 0.2s;
}

.eye-btn:hover { color: var(--accent-soft); }

.form-error {
  display: block;
  font-size: 0.8rem;
  color: #ff6b6b;
  margin-top: 5px;
  min-height: 16px;
}

.auth-switch {
  font-size: 0.85rem;
  color: var(--text-secondary);
  margin-top: 16px;
  text-align: center;
}

.auth-message {
  margin-top: 14px;
  font-size: 0.88rem;
  text-align: center;
  min-height: 20px;
}

.msg-success { color: var(--teal); }
.msg-error { color: #ff6b6b; }

/* Logged In Panel */
.logged-in-content {
  text-align: center;
  padding: 10px 0;
}

.avatar {
  font-size: 3rem;
  margin-bottom: 14px;
}

/* =============================================
   FOOTER
   ============================================= */
.footer {
  background: var(--bg-secondary);
  border-top: 1px solid var(--border);
  padding: 48px 24px;
  text-align: center;
}

.footer-inner {
  max-width: 600px;
  margin: 0 auto;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  justify-content: center;
  font-family: 'Playfair Display', serif;
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.footer-tagline {
  font-size: 0.9rem;
  color: var(--text-secondary);
  margin-bottom: 16px;
  font-style: italic;
}

.footer-copy {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* =============================================
   SCROLL-TO-TOP BUTTON
   ============================================= */
.scroll-top {
  position: fixed;
  bottom: 28px;
  right: 28px;
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 1.1rem;
  border: none;
  cursor: pointer;
  display: none;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-accent);
  transition: all 0.25s;
  z-index: 999;
}

.scroll-top:hover { background: var(--accent-soft); transform: translateY(-2px); }
.scroll-top.visible { display: flex; }

/* =============================================
   RESPONSIVE
   ============================================= */
@media (max-width: 900px) {
  .analytics-cards { grid-template-columns: repeat(2, 1fr); }
  .diary-grid { grid-template-columns: 1fr; }
  .hero-moon { display: none; }
  .hero-content { padding: 60px 24px; }
}

@media (max-width: 680px) {
  .nav-links { display: none; flex-direction: column; position: absolute; top: var(--nav-height); left: 0; right: 0; background: var(--bg-secondary); padding: 16px; gap: 4px; border-bottom: 1px solid var(--border); }
  .nav-links.open { display: flex; }
  .hamburger { display: block; }
  .analytics-cards { grid-template-columns: 1fr 1fr; }
  .weekly-inputs { grid-template-columns: repeat(4, 1fr); }
  .tracker-card { padding: 24px; }
  .auth-form { padding: 24px; }
  .time-inputs { flex-direction: column; }
  .input-arrow { display: none; }
  .quote-card { padding: 28px 24px; }
  .bar-graph { gap: 5px; }
}

@media (max-width: 480px) {
  .analytics-cards { grid-template-columns: 1fr; }
  .weekly-inputs { grid-template-columns: repeat(3, 1fr); }
  .hero-stats { flex-direction: column; align-items: flex-start; gap: 16px; }
  .stat-divider { display: none; }
}

/* =============================================
   UTILITIES
   ============================================= */
.hidden { display: none !important; }

</body>
</html>
