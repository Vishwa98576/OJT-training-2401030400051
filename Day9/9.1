<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>About Us - Flower Shop</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<style>


body{
    margin:0;
    font-family:Arial, sans-serif;
    background:#fff5f8;
    color:#333;
}

header{
    background:#ffb6c1;
    padding:20px;
    text-align:center;
    color:white;
}

header h1{
    margin:0;
    font-size:40px;
}

.about{
    width:80%;
    margin:auto;
    padding:40px 0;
    text-align:center;
}

.about img{
    width:300px;
    border-radius:15px;
}

.about h1{
    color:#ff4d79;
    font-weight: bold;
    font-family: 'Times New Roman', Times, serif;
}


.about p{
    font-size:18px;
    line-height:1.7;
}

.icons{
    display:flex;
    justify-content:center;
    gap:40px;
    margin-top:40px;
}



footer{
    background:#f299a6;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:40px;
}

</style>
</head>

<body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<header>
<h1>Florium Flower Shop</h1>
</header>

<section class="about">

<img src="data:image/jpeg;base64," alt="Flower Shop">

<h1>About Us</h1>

<p>
Welcome to Florium Flower Shop. We create beautiful bouquets
for birthdays, weddings, anniversaries, and every special moment.
Our mission is to spread happiness with fresh and colorful flowers.
</p>

<div class="icons">

<div style="max-width: 300px; width: 100%;"> 
  
  <!-- The Square Container -->
  <div class="ratio ratio-1x1">
    <div class="bg-white p-4 rounded-3 shadow d-flex flex-column justify-content-center align-items-center text-center">
      <div>
        <i class="bi bi-house-fill" 
        style="color: #ff4d79;  font-size:80px;"></i>
        <h3 class="fs-2 my-2">Our Shop</h3>
        <p class="mb-0 small lh-sm">Fresh flowers every day.</p>
      </div>
    </div>
  </div>

</div>
<!-- Set your desired grid or width on this outer wrapper -->
<div style="max-width: 300px; width: 100%;"> 
  
  <!-- The Square Container -->
<div class="ratio ratio-1x1">
  <div class="bg-white p-4 rounded-3 shadow d-flex flex-column justify-content-center align-items-center text-center">
    <div>
      <i class="bi bi-person-fill" 
         style="color:#ff4d79; font-size:80px;"></i>

      <h3 class="fs-2 my-2">Our Team</h3>
      <p class="mb-0 small lh-sm">Creative bouquet designers.</p>
    </div>
  </div>
</div>

</div>

<!-- Set your desired grid or width on this outer wrapper -->
<div style="max-width: 300px; width: 100%;"> 
  
  <!-- The Square Container -->
  <div class="ratio ratio-1x1"> 
  <div class="bg-white p-4 rounded-3 shadow d-flex flex-column justify-content-center align-items-center text-center"> 
    <div> 
      <i class="bi bi-envelope-fill "
       style="color: #ff4d79; font-size:80px;"></i> 
      <h3 class="fs-2 my-2">Contact</h3> 
      <p class="mb-0 small lh-sm">Always ready to help you.</p> 
    </div> 
  </div> 
</div>


</div>
</div>

</section>

<footer>
<p>© 2026 Florium Flower Shop</p>
</footer>

</body>
</html>
